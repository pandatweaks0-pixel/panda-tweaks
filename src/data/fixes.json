[
  {
    "id": "fix_audio",
    "name": "Audio & Microphone",
    "description": "No sound or microphone? Puts the audio services back to their defaults and starts them.",
    "operations": [
      {
        "type": "service",
        "name": "Audiosrv",
        "startMode": "auto",
        "stop": false,
        "start": true
      },
      {
        "type": "service",
        "name": "AudioEndpointBuilder",
        "startMode": "auto",
        "stop": false,
        "start": true
      }
    ]
  },
  {
    "id": "fix_bluetooth",
    "name": "Bluetooth",
    "description": "Bluetooth missing or not connecting? Re-enables and starts the Bluetooth support service.",
    "operations": [
      {
        "type": "service",
        "name": "bthserv",
        "startMode": "manual",
        "stop": false,
        "start": true
      }
    ]
  },
  {
    "id": "fix_search",
    "name": "Windows Search",
    "description": "Start menu search broken? Re-enables the search service and its index.",
    "operations": [
      {
        "type": "service",
        "name": "WSearch",
        "startMode": "delayed-auto",
        "stop": false,
        "start": true
      }
    ]
  },
  {
    "id": "fix_printing",
    "name": "Printing",
